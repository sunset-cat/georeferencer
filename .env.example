# Automatically loaded from the working directory; shell variables take precedence.
OPENAI_API_KEY=
GEO_MODEL=gpt-6.1-sol
GEO_REASONING_EFFORT=low
GEO_WEB_SEARCH_MODEL=gpt-6-luna
GEO_WEB_SEARCH_REASONING_EFFORT=low
GEO_VERIFICATION_MODEL=gpt-6.1-sol
GEO_VERIFICATION_REASONING_EFFORT=low
GEO_MAX_VERIFICATION_REQUESTS=12
GEO_REGISTRY_PATH=
GEO_GEOCODER_PROVIDER=photon
GEO_GEOCODER_URL=https://photon.komoot.io/api/
GEO_GEOCODER_USER_AGENT=georeferencer-poc/0.1
GEO_LOG_DIR=logs
GEO_LIBRARY_DIR=data/library
# Larger reports used to verify web-search candidates; cached as local snapshots.
GEO_SOURCE_DOCUMENT_CACHE_DIR=data/source_documents
GEO_MAX_SOURCE_DOWNLOAD_BYTES=50000000
GEO_MAX_SOURCE_PDF_PAGES=1000
GEO_WEB_SEARCH_ENABLED=true
GEO_MAX_WEB_REQUESTS=8

# Soft estimate threshold: finish the current request, then leave unfinished work pending.
GEO_MAX_RUN_COST_USD=0.50
GEO_MAX_GEOCODER_CALLS=80
GEO_MAX_DOWNLOAD_CALLS=16

# Warning-only semantic-unit extent review, using the verification model/effort.
# No web tools. Cached by group context and coordinates; included in run cost.
GEO_GEOGRAPHIC_AUDIT_ENABLED=true
GEO_MAX_GEOGRAPHIC_AUDIT_REQUESTS=8
GEO_GEOCODER_REFINEMENT_ENABLED=true
GEO_MAX_GEOCODER_REFINEMENT_REQUESTS=8
